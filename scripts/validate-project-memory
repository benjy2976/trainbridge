# isolated mode before importing validator dependencies so neither scripts/ nor
# PYTHONPATH can shadow json, yaml, ast or another module.
if not sys.flags.isolated:
    import os as bootstrap_os

    bootstrap_os.execv(
        sys.executable,
        [sys.executable, "-I", sys.argv[0], *sys.argv[1:]],
    )

