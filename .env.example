# Copiar a .env y completar con los valores reales del NUC.
# .env NO se versiona (contiene un token con permiso de escritura en el
# NUC) -- ver .gitignore. Crear siempre el archivo localmente; no transferir
# un .env existente desde otro equipo.

# Dónde corre review_server.py. Usar una URL alcanzable desde el worker;
# no versionar aquí una IP o un hostname real del entorno.
REVIEW_URL=http://nuc.example.test:8850

# Lo imprime review_server.py al iniciar, y también vive en
# salida/.upload_token en el NUC. Sin esto, /api/export y /api/model
# devuelven 401.
REVIEW_TOKEN=
