# Copiar a .env y completar con los valores reales del NUC.
# .env NO se versiona (contiene un token con permiso de escritura en el
# NUC) -- ver .gitignore. Si ya recibiste este proyecto por rsync desde el
# NUC, probablemente .env ya viene completado y no hace falta tocar nada.

# Dónde corre review_server.py en el NUC. Preferir la IP de Tailscale
# (funciona desde cualquier red); si el equipo con GPU está en la misma
# LAN que el NUC, también sirve la IP de LAN (ej: http://192.168.1.40:8850).
REVIEW_URL=http://100.85.253.49:8850

# Lo imprime review_server.py al iniciar, y también vive en
# salida/.upload_token en el NUC. Sin esto, /api/export y /api/model
# devuelven 401.
REVIEW_TOKEN=
